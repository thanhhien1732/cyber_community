{
  "name": "cyber_community",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --watchAll",
    "dev": "nodemon --import=extensionless/register server.js",
    "start": "node --import=extensionless/register server.js",
    "prisma": "npx prisma db pull && npx prisma generate"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/common/test/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/generated/"
    ]
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@types/jest": "^30.0.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "extensionless": "^1.9.9",
    "graphql": "^16.11.0",
    "graphql-http": "^1.22.4",
    "jest": "^30.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "ruru": "^2.0.0-beta.30",
    "sequelize": "^6.37.7",
    "sequelize-auto": "^0.8.8",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "prisma": "^6.14.0"
  }
}
